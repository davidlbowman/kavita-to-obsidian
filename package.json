{
	"name": "kavita-to-obsidian",
	"version": "1.3.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run scripts/build.ts",
		"build": "bun run scripts/build.ts --production",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:obsidian": "eslint src/",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "bun run lint && bun run lint:obsidian && bun run typecheck && bun run test:coverage && bun run build",
		"integration": "bun run integration:down && bun run integration:up && bun run integration:test",
		"integration:fixtures": "bun run test-integration/scripts/build-fixtures.ts",
		"integration:up": "bun run integration:fixtures && docker compose -f test-integration/docker-compose.yml up -d",
		"integration:test": "vitest run -c vitest.integration.config.ts",
		"integration:down": "docker compose -f test-integration/docker-compose.yml down -v",
		"integration:logs": "docker compose -f test-integration/docker-compose.yml logs -f"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@effect/language-service": "0.87.4",
		"@effect/vitest": "4.0.3",
		"@eslint/js": "9.39.5",
		"@types/bun": "1.3.13",
		"@types/node": "24.19.2",
		"@typescript-eslint/parser": "8.71.1",
		"@vitest/coverage-v8": "5.0.4",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"obsidian": "1.14.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vitest": "5.0.4"
	},
	"dependencies": {
		"effect": "4.0.3"
	},
	"packageManager": "bun@1.3.13"
}
